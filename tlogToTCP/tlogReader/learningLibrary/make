# Compiler and flags
CXX = g++
CXXFLAGS = -Wall -std=c++11

# Source files
SRC = mainCode.cpp mathexp.cpp

# Targets
all: exampleCode exampleCode2

exampleCode: $(SRC)
	$(CXX) $(CXXFLAGS) $(SRC) -o exampleCode

exampleCode2: $(SRC)
	$(CXX) $(CXXFLAGS) $(SRC) -o exampleCode2

# Clean target
clean:
	rm -f exampleCode exampleCode2
